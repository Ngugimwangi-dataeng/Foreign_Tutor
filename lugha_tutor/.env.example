# Django Core
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-secret-string
ALLOWED_HOSTS=127.0.0.1,localhost

# Hidden Django Admin URL (never use /admin/ in production)
ADMIN_URL_PATH=secure-faculty-admin-9f3a/

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Individual database variables
DB_NAME=DATABASE
DB_USER=USER
DB_PASSWORD=replace-with-your-database-password
DB_HOST=HOST
DB_PORT=5432

# Main API backend PostgreSQL database
# Set LUGHA_DATABASE_URL for a managed PostgreSQL URL; it takes precedence over LUGHA_DB_*.
LUGHA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
LUGHA_DB_NAME=lughasmart_db
LUGHA_DB_USER=postgres
LUGHA_DB_PASSWORD=replace-with-your-database-password
LUGHA_DB_HOST=127.0.0.1
LUGHA_DB_PORT=5432

# Paystack (M-Pesa Mobile Money + Visa/Mastercard in KES)
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=http://127.0.0.1:8000/payments/paystack/callback/

# CSRF & Site URL (for production HTTPS deployments)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
